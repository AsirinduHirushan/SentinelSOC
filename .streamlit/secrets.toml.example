# EXAMPLE ONLY. Never commit .streamlit/secrets.toml.
# Establish a separate SSH tunnel to your lab Wazuh Indexer:
# ssh -N -L 127.0.0.1:9200:127.0.0.1:9200 YOUR_SSH_USER@YOUR_WAZUH_SERVER_IP
[indexer]
url = "https://127.0.0.1:9200"
username = "YOUR_READ_ONLY_INDEXER_USER"
password = "REPLACE_LOCALLY"
verify_tls = true
# Set this to the path to your locally trusted CA file in your private secrets.toml:
# ca_bundle = ".streamlit/certs/wazuh-root-ca.pem"
